{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "walkthrough_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "english_stop", "english_stemmer"]
        }
      },
      "filter": {
        "english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        },
        "english_stemmer": {
          "type": "stemmer",
          "language": "english"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": { "type": "keyword" },
      "userId": { "type": "keyword" },
      "authorName": {
        "type": "keyword",
        "fields": {
          "text": { "type": "text", "analyzer": "walkthrough_text" }
        }
      },
      "owner": { "type": "keyword" },
      "repo": { "type": "keyword" },
      "repoFull": { "type": "keyword" },
      "prNumber": { "type": "integer" },
      "title": {
        "type": "text",
        "analyzer": "walkthrough_text",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 500 }
        }
      },
      "description": { "type": "text", "analyzer": "walkthrough_text" },
      "chapters": {
        "type": "nested",
        "properties": {
          "title": { "type": "text", "analyzer": "walkthrough_text" },
          "content": { "type": "text", "analyzer": "walkthrough_text" }
        }
      },
      "status": { "type": "keyword" },
      "createdAt": { "type": "date" },
      "updatedAt": { "type": "date" }
    }
  }
}
