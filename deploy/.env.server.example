SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8096

# Database (matches .env.postgres)
DB_URL=jdbc:postgresql://postgres:5432/walkthrough
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Mail (use a Gmail App Password, not your account password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# CORS & URLs
CORS_ALLOWED_ORIGINS=https://walkthrough.io.vn
CLIENT_WEB_URL=https://walkthrough.io.vn

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET_KEY=change-me-use-a-long-random-string-at-least-64-chars
JWT_ACCESS_TOKEN_EXPIRY=300
JWT_REFRESH_TOKEN_EXPIRY=2592000

# GitHub OAuth App (create one at github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# RabbitMQ (matches .env.rabbitmq)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=change-me

# Elasticsearch
ELASTICSEARCH_URIS=http://elasticsearch:9200

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# AI
AI_PROVIDER=deepseek
AI_ENABLED=true
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEYy=xx-xxxx-xxxx-xxxx-xxxx
DEEPSEEK_MODEL=deepseek-model-001